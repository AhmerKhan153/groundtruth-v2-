# Production settings for deploy/deploy.sh. Copy to deploy/prod.env (gitignored)
# and fill in. Runtime keys match .env; values here are what the cloud app gets.

# --- Azure -----------------------------------------------------------------------
# Container Apps and the Atlas cluster should share a region.
AZ_LOCATION=uaenorth
AZ_RESOURCE_GROUP=groundtruth-rg
AZ_ENVIRONMENT=groundtruth-env
AZ_APP=groundtruth
AZ_JOB=groundtruth-source
AZ_LOG_WORKSPACE=groundtruth-logs
# Scheduled job, evaluated in UTC: 05:00 UTC = 09:00 Dubai. Runs daily; the app's
# 44h check turns that into every other day.
SOURCE_CRON=0 5 * * *

# --- Image (GitHub Container Registry, private) --------------------------------
# Built by .github/workflows/image.yml as ghcr.io/<owner>/groundtruth:<commit sha>.
GHCR_USERNAME=AhmerKhan153
# Classic personal access token with ONLY the read:packages scope. Azure uses it
# to pull the image; deploy.sh uses it to check the image exists first.
GHCR_TOKEN=

# --- App runtime (stored as Container Apps secrets where sensitive) ------------
LLM_API_BASE=https://api.deepseek.com
LLM_MODEL=deepseek-flash
LLM_API_KEY=
LLM_EXTRA_BODY={"thinking": {"type": "disabled"}}
LLM_MAX_TOKENS=4096
LLM_TIMEOUT_SECONDS=45
LLM_MAX_RETRIES=1

# Atlas: mongodb+srv://<user>:<password>@<cluster>/?retryWrites=true&w=majority
MONGODB_URI=
MONGODB_DB_NAME=groundtruth

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# python -c "import secrets; print(secrets.token_urlsafe(32))"
TELEGRAM_WEBHOOK_SECRET=
JOB_SECRET=
STORIES_PER_RUN=6
# Minimum hours between pick lists. 44 = every other day; 0 while testing.
SOURCE_INTERVAL_HOURS=44
