# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- LLM ---
# LLM_PROVIDER: "claude" (default, Anthropic API) or "ollama" (local)
LLM_PROVIDER=claude
# Required when LLM_PROVIDER=claude
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-4-8
CLAUDE_MAX_TOKENS=4096
# Used only when LLM_PROVIDER=ollama
OLLAMA_MODEL=qwen3:4b
# GPU tuning. Smaller context => smaller KV cache => more layers fit on the GPU.
OLLAMA_NUM_CTX=4096
# Force N layers onto the GPU. Ollama's auto mode under-offloads and leaves VRAM
# idle; 99 = force ALL layers (incl. output layer) for 100% GPU. Lower it (or
# blank for auto) if the model is too big to fit your VRAM and OOMs.
OLLAMA_NUM_GPU=99

# --- MongoDB ---
MONGODB_URI=mongodb://localhost:27017/
MONGODB_DB_NAME=KnowledgeExtractor

# --- LinkedIn (see LINKEDIN_SETUP.md) ---
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_AUTHOR_URN=
