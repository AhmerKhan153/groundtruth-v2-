# --- LLM (DeepSeek, OpenAI-compatible) -----------------------------------------
# groundtruth/llm.py is the only caller. Same settings locally and on Cloud Run.
LLM_API_BASE=https://api.deepseek.com
LLM_MODEL=deepseek-flash
LLM_API_KEY=
# JSON merged into every request body. DeepSeek thinks by default; turn it off.
LLM_EXTRA_BODY={"thinking": {"type": "disabled"}}
LLM_MAX_TOKENS=4096
# Keep fetch (15s) + 2 x timeout x (1 + retries) well under Cloud Run's 300s.
LLM_TIMEOUT_SECONDS=45
LLM_MAX_RETRIES=1

# --- MongoDB -----------------------------------------------------------------
# Local: mongodb://localhost:27017/   Production: the Atlas mongodb+srv:// URI.
# Run `python -m scripts.init_db` once per database to create the indexes.
MONGODB_URI=mongodb://localhost:27017/
MONGODB_DB_NAME=groundtruth

# --- Telegram ------------------------------------------------------------------
# Use a separate dev bot locally: a bot can have a webhook OR getUpdates, not both.
TELEGRAM_BOT_TOKEN=
# Your own chat id; taps from any other chat are ignored.
TELEGRAM_CHAT_ID=
# Random string; Telegram echoes it on every webhook call (set via setWebhook).
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
TELEGRAM_WEBHOOK_SECRET=

# --- Source job ----------------------------------------------------------------
# Random string Cloud Scheduler sends as X-Job-Secret. Unset = /jobs/source refuses all calls.
JOB_SECRET=
STORIES_PER_RUN=6
# Minimum hours between pick lists (daily schedule + 44 = every other day). 0 = every run sends.
SOURCE_INTERVAL_HOURS=44
