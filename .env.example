# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- LLM ---
# Which backend src/llm.py builds. Adapters are imported lazily, so you only need
# the SDK for the provider you pick.
#   ollama  -> a model running locally; no API key, no network
#   openai  -> any endpoint speaking the OpenAI chat protocol (set LLM_API_BASE for
#              a self-hosted server or a gateway to another provider)
LLM_PROVIDER=ollama

# Hosted providers only. No default on purpose -- set the model id your provider
# expects, or the app tells you it is missing instead of 404-ing mid-generation.
LLM_MODEL=
LLM_MAX_TOKENS=4096
# Leave blank to let the provider SDK read its own conventional key variable.
LLM_API_KEY=
# Optional: base URL for an OpenAI-compatible endpoint (vLLM, llama.cpp,
# LM Studio, a gateway). Blank talks to the SDK's default host.
LLM_API_BASE=

# Used only when LLM_PROVIDER=ollama
OLLAMA_MODEL=qwen3:4b
# GPU tuning. Smaller context => smaller KV cache => more layers fit on the GPU.
OLLAMA_NUM_CTX=4096
# Force N layers onto the GPU. Ollama's auto mode under-offloads and leaves VRAM
# idle; 99 = force ALL layers (incl. output layer) for 100% GPU. Lower it (or
# blank for auto) if the model is too big to fit your VRAM and OOMs.
OLLAMA_NUM_GPU=99

# --- MongoDB ---
MONGODB_URI=mongodb://localhost:27017/
MONGODB_DB_NAME=groundtruth

# --- LinkedIn (see LINKEDIN_SETUP.md) ---
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_AUTHOR_URN=
